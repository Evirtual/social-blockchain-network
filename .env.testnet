# Frontend (Vite) testnet build config

# -------------------------------
# Contract addresses (SocialPosts)
# -------------------------------
VITE_CONTRACT_ADDRESS_SEPOLIA=0x98df111eEA0365949FDFec58404474D0d7eE2261
VITE_CONTRACT_ADDRESS_BASE_SEPOLIA=0xbDb8A4BfCF5146f584Bf32B4F8c6E70ecB1DF8f1
VITE_CONTRACT_ADDRESS_BSC_TESTNET=0xa6754993555723db96D08cBAC70dD38FC04DBa69

# -------------------------------
# RPC URLs (HTTP + WebSocket)
# -------------------------------
VITE_ETH_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_BASE_SEPOLIA_RPC_URL=https://base-sepolia.publicnode.com
VITE_BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com

# -------------------------------
# The Graph subgraph URLs
# -------------------------------
VITE_ETH_SEPOLIA_SUBGRAPH_URL=https://api.studio.thegraph.com/query/1721419/social-posts-eth-sepolia/v0.0.17-local-final
VITE_BASE_SEPOLIA_SUBGRAPH_URL=https://api.studio.thegraph.com/query/1721419/social-posts-base-sepolia/v0.0.17-local-final
VITE_BSC_TESTNET_SUBGRAPH_URL=https://api.studio.thegraph.com/query/1721419/social-posts-bsc-testnet/v0.0.17-local-final

# -------------------------------
# Explorer base URLs
# -------------------------------
VITE_ETH_SEPOLIA_EXPLORER_BASE_URL=https://sepolia.etherscan.io
VITE_BASE_SEPOLIA_EXPLORER_BASE_URL=https://sepolia.basescan.org
VITE_BSC_TESTNET_EXPLORER_BASE_URL=https://testnet.bscscan.com

# -------------------------------
# IPFS + Pinata worker
# -------------------------------
VITE_IPFS_GATEWAY=https://peach-managing-orangutan-155.mypinata.cloud/ipfs/
VITE_PINATA_WORKER_URL=https://social-posts-pinata.social-posts-pinata.workers.dev

# -------------------------------
# Subgraph request logging (DEV)
# -------------------------------
VITE_SUBGRAPH_LOG=false
VITE_SUBGRAPH_LOG_SUMMARY_EVERY=25
