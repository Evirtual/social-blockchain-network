# Frontend (Vite) environment variables
# Copy to .env.local for local development.

# Deployed SocialPosts contract address for the chain you will connect to
# (Legacy single-network)
VITE_CONTRACT_ADDRESS=

# (Recommended) Multi-network addresses (one frontend supports multiple chains)
# Ethereum Mainnet (chainId 1)
VITE_CONTRACT_ADDRESS_ETH=
# Ethereum Sepolia (chainId 11155111)
VITE_CONTRACT_ADDRESS_SEPOLIA=
# Base Mainnet (chainId 8453)
VITE_CONTRACT_ADDRESS_BASE=
# Base Sepolia (chainId 84532)
VITE_CONTRACT_ADDRESS_BASE_SEPOLIA=
# BNB Smart Chain Mainnet (chainId 56)
VITE_CONTRACT_ADDRESS_BSC=
# BSC Testnet (chainId 97)
VITE_CONTRACT_ADDRESS_BSC_TESTNET=

# Optional (read-only): RPC URLs used by the frontend to load posts from multiple networks
# NOTE: Anything prefixed with VITE_ is embedded into the browser bundle.
# Use public endpoints or restricted keys only.
VITE_RPC_URL_ETH=
VITE_RPC_URL_SEPOLIA=
VITE_RPC_URL_BASE=
VITE_RPC_URL_BASE_SEPOLIA=
VITE_RPC_URL_BSC=
VITE_RPC_URL_BSC_TESTNET=

# Optional: public IPFS gateway base used for ipfs:// -> https:// resolution
# Example: https://ipfs.io/ipfs/
VITE_IPFS_GATEWAY=

# Optional (DEV ONLY): Pinata JWT used for direct client-side pinning.
# WARNING: Anything prefixed with VITE_ is embedded into the browser bundle.
# Do NOT use this in production. Use a backend/serverless endpoint to pin.
VITE_PINATA_JWT=

# -------------------------------
# Hardhat deploy configuration
# -------------------------------

# Private key of the deployer wallet (NO 0x prefix)
DEPLOYER_PRIVATE_KEY=

# RPC URLs
ETH_RPC_URL=
ETH_SEPOLIA_RPC_URL=
BASE_RPC_URL=
BASE_SEPOLIA_RPC_URL=
BSC_RPC_URL=
BSC_TESTNET_RPC_URL=

# Optional block explorer API keys (for `npx hardhat verify`)
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
BSCSCAN_API_KEY=
