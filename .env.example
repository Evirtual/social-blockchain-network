# Frontend (Vite) environment variables
# Copy to .env.local for local development.

# -------------------------------
# Contract addresses (SocialPosts)
# -------------------------------
# Use the chain-specific keys below.
# Chain IDs: ETH=1, ETH Sepolia=11155111, Base=8453, Base Sepolia=84532, BSC=56, BSC Testnet=97, Local=31337
VITE_CONTRACT_ADDRESS_ETH=
VITE_CONTRACT_ADDRESS_SEPOLIA=
VITE_CONTRACT_ADDRESS_BASE=
VITE_CONTRACT_ADDRESS_BASE_SEPOLIA=
VITE_CONTRACT_ADDRESS_BSC=
VITE_CONTRACT_ADDRESS_BSC_TESTNET=
VITE_CONTRACT_ADDRESS_LOCAL=

# -------------------------------
# RPC URLs (HTTP + WebSocket)
# -------------------------------
# HTTP is used for reads and subgraph fallbacks. WS enables event-driven refresh.
# Local Hardhat node (chainId 31337)
VITE_LOCAL_RPC_URL=
VITE_LOCAL_RPC_WS_URL=

# Public RPC URLs for multi-network FEED reads (browser-side, must be CORS-enabled)
VITE_ETH_RPC_URL=
VITE_ETH_RPC_WS_URL=
VITE_ETH_SEPOLIA_RPC_URL=
VITE_ETH_SEPOLIA_RPC_WS_URL=
VITE_BASE_RPC_URL=
VITE_BASE_RPC_WS_URL=
VITE_BASE_SEPOLIA_RPC_URL=
VITE_BASE_SEPOLIA_RPC_WS_URL=
VITE_BSC_RPC_URL=
VITE_BSC_RPC_WS_URL=
VITE_BSC_TESTNET_RPC_URL=
VITE_BSC_TESTNET_RPC_WS_URL=

# -------------------------------
# The Graph subgraph URLs
# -------------------------------
# If set, the Main Feed will use the subgraph for that chain (more reliable than scanning blocks).
VITE_ETH_SUBGRAPH_URL=
VITE_ETH_SEPOLIA_SUBGRAPH_URL=
VITE_BASE_SUBGRAPH_URL=
VITE_BASE_SEPOLIA_SUBGRAPH_URL=
VITE_BSC_SUBGRAPH_URL=
VITE_BSC_TESTNET_SUBGRAPH_URL=

# -------------------------------
# Explorer base URLs
# -------------------------------
# These are base URLs only; the app will append /tx/<hash> internally.
# Examples:
# - https://etherscan.io
# - https://sepolia.etherscan.io
# - https://basescan.org
# - https://sepolia.basescan.org
# - https://bscscan.com
# - https://testnet.bscscan.com
VITE_ETH_EXPLORER_BASE_URL=
VITE_ETH_SEPOLIA_EXPLORER_BASE_URL=
VITE_BASE_EXPLORER_BASE_URL=
VITE_BASE_SEPOLIA_EXPLORER_BASE_URL=
VITE_BSC_EXPLORER_BASE_URL=
VITE_BSC_TESTNET_EXPLORER_BASE_URL=

# -------------------------------
# IPFS
# -------------------------------
# Example: https://ipfs.io/ipfs/
VITE_IPFS_GATEWAY=

# -------------------------------
# Pinata (DEV ONLY)
# -------------------------------
# WARNING: Anything prefixed with VITE_ is embedded into the browser bundle.
# Do NOT use this in production. Use a backend/serverless endpoint to pin.
VITE_PINATA_JWT=

# -------------------------------
# Subgraph request logging (DEV)
# -------------------------------
# When enabled, the app prints one grouped log per request and periodic summary tables.
VITE_SUBGRAPH_LOG=false
# Print summary tables every N requests (default: 25)
VITE_SUBGRAPH_LOG_SUMMARY_EVERY=25
