# Frontend (Vite) environment variables
# Copy to .env.local for local development.

# Deployed SocialPosts contract address for the chain you will connect to
VITE_CONTRACT_ADDRESS=

# Optional: public IPFS gateway base used for ipfs:// -> https:// resolution
# Example: https://ipfs.io/ipfs/
VITE_IPFS_GATEWAY=

# Optional (DEV ONLY): Pinata JWT used for direct client-side pinning.
# WARNING: Anything prefixed with VITE_ is embedded into the browser bundle.
# Do NOT use this in production. Use a backend/serverless endpoint to pin.
VITE_PINATA_JWT=
