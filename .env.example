# Frontend (Vite) environment variables
# Copy to .env.local for local development.

# Deployed SocialPosts contract address for the chain you will connect to
# (Legacy single-network)
VITE_CONTRACT_ADDRESS=
# (Recommended) Multi-network addresses (one frontend supports multiple chains)
# Ethereum Mainnet (chainId 1)
VITE_CONTRACT_ADDRESS_ETH=
# Ethereum Sepolia (chainId 11155111)
VITE_CONTRACT_ADDRESS_SEPOLIA=
# Base Mainnet (chainId 8453)
VITE_CONTRACT_ADDRESS_BASE=
# Base Sepolia (chainId 84532)
VITE_CONTRACT_ADDRESS_BASE_SEPOLIA=
# BNB Smart Chain Mainnet (chainId 56)
VITE_CONTRACT_ADDRESS_BSC=
# BSC Testnet (chainId 97)
VITE_CONTRACT_ADDRESS_BSC_TESTNET=

# Local Hardhat node (chainId 31337)
# Example: http://127.0.0.1:8545
VITE_LOCAL_RPC_URL=
# Optional: public RPC URLs for multi-network FEED reads (browser-side, must be CORS-enabled)
# If set, the Main Feed can aggregate posts across multiple networks.
VITE_ETH_RPC_URL=
VITE_ETH_SEPOLIA_RPC_URL=
VITE_BASE_RPC_URL=
VITE_BASE_SEPOLIA_RPC_URL=
VITE_BSC_RPC_URL=
VITE_BSC_TESTNET_RPC_URL=

# Optional: The Graph subgraph URLs per network.
# If set, the Main Feed will use the subgraph for that chain (more reliable than scanning blocks).
VITE_ETH_SUBGRAPH_URL=
VITE_ETH_SEPOLIA_SUBGRAPH_URL=
VITE_BASE_SUBGRAPH_URL=
VITE_BASE_SEPOLIA_SUBGRAPH_URL=
VITE_BSC_SUBGRAPH_URL=
VITE_BSC_TESTNET_SUBGRAPH_URL=

# Optional: block explorer base URLs used to build transaction links.
# IMPORTANT: These are base URLs only; the app will append /tx/<hash> internally.
# Example values:
# - https://etherscan.io
# - https://sepolia.etherscan.io
# - https://basescan.org
# - https://sepolia.basescan.org
# - https://bscscan.com
# - https://testnet.bscscan.com
#
# Configure per chainId using this naming:
#   VITE_EXPLORER_BASE_URL_<chainId>
#
# Ethereum Mainnet (chainId 1)
VITE_EXPLORER_BASE_URL_1=
# Ethereum Sepolia (chainId 11155111)
VITE_EXPLORER_BASE_URL_11155111=
# Base Mainnet (chainId 8453)
VITE_EXPLORER_BASE_URL_8453=
# Base Sepolia (chainId 84532)
VITE_EXPLORER_BASE_URL_84532=
# BNB Smart Chain Mainnet (chainId 56)
VITE_EXPLORER_BASE_URL_56=
# BSC Testnet (chainId 97)
VITE_EXPLORER_BASE_URL_97=

# Optional: public IPFS gateway base used for ipfs:// -> https:// resolution
# Example: https://ipfs.io/ipfs/
VITE_IPFS_GATEWAY=

# Optional (DEV ONLY): Pinata JWT used for direct client-side pinning.
# WARNING: Anything prefixed with VITE_ is embedded into the browser bundle.
# Do NOT use this in production. Use a backend/serverless endpoint to pin.
VITE_PINATA_JWT=

# Optional: formatted console logs for subgraph requests (DEV)
# When enabled, the app prints one grouped log per request and periodic summary tables.
VITE_SUBGRAPH_LOG=false
# Print summary tables every N requests (default: 25)
VITE_SUBGRAPH_LOG_SUMMARY_EVERY=25

# -------------------------------
# Hardhat deploy configuration
# -------------------------------

# Private key of the deployer wallet
DEPLOYER_PRIVATE_KEY=

# RPC URLs
ETH_RPC_URL=
ETH_SEPOLIA_RPC_URL=
BASE_RPC_URL=
BASE_SEPOLIA_RPC_URL=
BSC_RPC_URL=
BSC_TESTNET_RPC_URL=

# Optional block explorer API keys (for `npx hardhat verify`)
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
BSCSCAN_API_KEY=
