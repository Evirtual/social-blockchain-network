# Local-only Vite overrides (DO NOT COMMIT secrets)
# Copy to .env.local for local development.

# Local Hardhat deploy writes here (legacy fallback used for localhost chain)
VITE_CONTRACT_ADDRESS=

# Optional (read-only): RPC URLs used by the frontend to load posts from multiple networks
# NOTE: Anything prefixed with VITE_ is embedded into the browser bundle.
VITE_RPC_URL_ETH=
VITE_RPC_URL_SEPOLIA=
VITE_RPC_URL_BASE=
VITE_RPC_URL_BASE_SEPOLIA=
VITE_RPC_URL_BSC=
VITE_RPC_URL_BSC_TESTNET=

# Optional: public IPFS gateway base used for ipfs:// -> https:// resolution
VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/

# IMPORTANT:
# Anything prefixed with VITE_ is embedded into the browser bundle.
# Do NOT put real secrets here.
#
# DEV ONLY (not recommended):
# VITE_PINATA_JWT=
