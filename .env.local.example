# Local-only Vite overrides (DO NOT COMMIT secrets)
# Copy to .env.local for local development.

# Local Hardhat deploy writes here (legacy fallback used for localhost chain)
VITE_CONTRACT_ADDRESS=

# Optional: public IPFS gateway base used for ipfs:// -> https:// resolution
VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/

# IMPORTANT:
# Anything prefixed with VITE_ is embedded into the browser bundle.
# Do NOT put real secrets here.
#
# DEV ONLY (not recommended):
# VITE_PINATA_JWT=
