# Subgraph endpoints (frontend)
# Copy to .env.local and fill with the Studio "Query URL" for each deployed subgraph.

VITE_BASE_SEPOLIA_SUBGRAPH_URL=
VITE_ETH_SEPOLIA_SUBGRAPH_URL=
VITE_BSC_TESTNET_SUBGRAPH_URL=

# Optional: Studio slugs used by the helper script `cd subgraph && npm run studio:commands`
# If you name them differently in Studio, set these so the printed deploy commands match.
STUDIO_SLUG_BASE_SEPOLIA=social-posts-base-sepolia
STUDIO_SLUG_ETH_SEPOLIA=social-posts-eth-sepolia
STUDIO_SLUG_BSC_TESTNET=social-posts-bsc-testnet
