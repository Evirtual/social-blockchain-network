{
  "name": "social-blockchain-network",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run test:contracts && npm run test:frontend",
    "test:contracts": "npm --prefix contracts test",
    "test:contracts:coverage": "npm --prefix contracts run coverage",
    "test:frontend": "vitest run",
    "test:frontend:coverage": "vitest run --coverage",
    "chain": "npm --prefix contracts run chain",
    "deploy:local": "npm --prefix contracts run deploy:local",
    "deploy:eth": "npm --prefix contracts run deploy:eth",
    "deploy:sepolia": "npm --prefix contracts run deploy:sepolia",
    "deploy:base": "npm --prefix contracts run deploy:base",
    "deploy:base:sepolia": "npm --prefix contracts run deploy:base:sepolia",
    "deploy:bsc": "npm --prefix contracts run deploy:bsc",
    "deploy:bsc:testnet": "npm --prefix contracts run deploy:bsc:testnet",
    "check:testnets": "npm --prefix contracts run check:testnets",
    "deploy:testnets": "npm --prefix contracts run deploy:testnets",
    "install:contracts": "npm --prefix contracts install"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.16",
    "buffer": "^6.0.3",
    "ethers": "^6.11.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.28",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "sass": "^1.97.2",
    "typescript": "^5.4.5",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
