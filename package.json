{
  "name": "social-blockchain-network",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run test:contracts && npm run test:frontend",
    "test:contracts": "hardhat test",
    "test:contracts:coverage": "hardhat coverage",
    "test:frontend": "vitest run",
    "test:frontend:coverage": "vitest run --coverage",
    "chain": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:eth": "hardhat run scripts/deploy.js --network ethereum",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:base": "hardhat run scripts/deploy.js --network base",
    "deploy:base:sepolia": "hardhat run scripts/deploy.js --network baseSepolia",
    "deploy:bsc": "hardhat run scripts/deploy.js --network bsc",
    "deploy:bsc:testnet": "hardhat run scripts/deploy.js --network bscTestnet",
    "check:testnets": "node scripts/check-testnets.js --target=base+eth+bsc",
    "deploy:testnets": "npm run check:testnets && npm run deploy:base:sepolia && npm run deploy:sepolia && npm run deploy:bsc:testnet"
  },
  "dependencies": {
    "ethers": "^6.11.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.0.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.18",
    "jsdom": "^26.1.0",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.10",
    "vitest": "^3.2.4"
  }
}
